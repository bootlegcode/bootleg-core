{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerFrame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "heartbeat_interval_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lease_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "notices": {
          "$ref": "#/$defs/Notices"
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        },
        "smuggler_session_id": {
          "$ref": "#/$defs/SmugglerSessionId"
        },
        "type": {
          "type": "string",
          "const": "registered"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "smuggler_session_id",
        "notices",
        "heartbeat_interval_seconds",
        "lease_timeout_seconds",
        "server_time"
      ]
    },
    {
      "type": "object",
      "properties": {
        "server_time": {
          "type": "string",
          "format": "date-time"
        },
        "smuggler_session_id": {
          "$ref": "#/$defs/SmugglerSessionId"
        },
        "type": {
          "type": "string",
          "const": "heartbeat_ack"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "smuggler_session_id",
        "server_time"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "error"
      ]
    }
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "level": {
          "$ref": "#/$defs/MessageLevel"
        },
        "message": {
          "description": "Server-authored display text; codes drive behavior, not local text lookup.",
          "$ref": "#/$defs/MessageText"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "level",
        "request_id"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unauthorized",
        "forbidden",
        "not_found",
        "validation",
        "rate_limited",
        "service_unavailable",
        "protocol_incompatible",
        "conflict",
        "quota_exceeded",
        "authorization_pending",
        "slow_down",
        "access_denied",
        "expired_token",
        "invalid_grant"
      ]
    },
    "MessageLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "MessageText": {
      "description": "No Unicode control characters or leading/trailing Unicode whitespace.",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "Notice": {
      "description": "Server-authored plain text. Severity affects presentation only, never exit\nstatus or retry policy. The stable ID is for deduplication, not text lookup.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NoticeId"
        },
        "level": {
          "$ref": "#/$defs/MessageLevel"
        },
        "message": {
          "$ref": "#/$defs/MessageText"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "message"
      ]
    },
    "NoticeId": {
      "description": "No Unicode control characters or leading/trailing Unicode whitespace.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "Notices": {
      "description": "Notice IDs must be unique within this response.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Notice"
      },
      "maxItems": 4
    },
    "RequestId": {
      "description": "No Unicode control characters or leading/trailing Unicode whitespace.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "SmugglerSessionId": {
      "description": "Canonical mti TypeID with RFC 4122 variant UUIDv4; prefix is type-specific.",
      "type": "string",
      "pattern": "^smuggler_session_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
